# Copy to .env (never commit .env). One KEY=value per line, no spaces around "=", no quotes needed.
TELEGRAM_BOT_TOKEN=123456789:token-from-BotFather
TELEGRAM_CHAT_ID=123456789
# Optional: the https address of the site, for the "Edit on site" button.
# SITE_URL=https://...
# Optional: time zone for "today" in the bot (default Europe/Kyiv).
# BOT_TZ=Europe/Kyiv

# Monobank (stage 7). Token from api.monobank.ua; the account ids come from: python -m monosync --accounts
# MONOBANK_TOKEN=...
# MONOBANK_ACCOUNTS=id1,id2,id3
